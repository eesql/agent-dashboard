# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./agent_dashboard.db

# OpenClaw API Configuration
# 获取方式：查看你的 OpenClaw 配置或运行 openclaw status
OPENCLAW_API_URL=http://localhost:8080
OPENCLAW_API_KEY=your-api-key-here

# Polling Configuration (seconds)
AGENT_STATUS_POLL_INTERVAL=5
METRICS_AGGREGATE_INTERVAL=60

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
